# OPENROUTER_API_KEY: Required for OpenRouter API calls to Claude/GPT models.
# Get your free API key from: https://openrouter.io/keys
# This key should be kept secret and never committed to version control.
OPENROUTER_API_KEY="your-openrouter-api-key-here"

# OPENROUTER_MODEL: The model to use for analysis (optional, defaults to openai/gpt-3.5-turbo)
# Other options: anthropic/claude-3-haiku, anthropic/claude-3-sonnet, etc.
OPENROUTER_MODEL="openai/gpt-3.5-turbo"
